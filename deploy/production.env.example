# Valores configurados no Coolify. Este arquivo é apenas referência e não contém segredos.
MYSQL_DATABASE=edulead
MYSQL_USER=edulead_app
MYSQL_PASSWORD=gere-uma-senha-forte-e-unica
MYSQL_ROOT_PASSWORD=gere-outra-senha-forte-e-unica

JWT_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
CORS_ALLOWED_ORIGIN=https://edulead.duckdns.org

# Habilite as integrações somente depois de cadastrar as credenciais no Coolify.
R2_ENABLED=true
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=edulead-arquivos
R2_ACCESS_KEY_ID=configure-no-coolify
R2_SECRET_ACCESS_KEY=configure-no-coolify
R2_MAX_FILE_SIZE=10MB
R2_MAX_FILE_SIZE_BYTES=10485760
R2_SIGNED_URL_MINUTES=10

AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=configure-no-coolify
AI_MODEL=gemini-3.5-flash-lite
