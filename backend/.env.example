# Copie estes valores para variáveis de ambiente no terminal; não versione o arquivo .env real.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/edulead?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=troque-por-sua-senha-local
JWT_SECRET=gere-um-segredo-com-ao-menos-32-caracteres
CORS_ALLOWED_ORIGIN=http://localhost:5173
SEED_ENABLED=true
FLYWAY_ENABLED=false
R2_ENABLED=false
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=edulead-arquivos
R2_ACCESS_KEY_ID=configure-no-ambiente
R2_SECRET_ACCESS_KEY=configure-no-ambiente
R2_MAX_FILE_SIZE=10MB
R2_MAX_FILE_SIZE_BYTES=10485760
R2_SIGNED_URL_MINUTES=10
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=configure-no-ambiente
AI_MODEL=gemini-3.5-flash-lite
